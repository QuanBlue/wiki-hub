# =============================================================================
# WikiHub environment configuration
#
# Copy to `.env` and adjust. NEVER commit the real `.env`.
#   cp .env.example .env
# =============================================================================

# --- Host port mapping -------------------------------------------------------
# Only affects which ports Docker publishes on your machine; the containers
# always talk to each other on their standard ports. `scripts/run.sh` selects
# the next free host port automatically when one is busy.
#
# The browser uses the current WikiHub origin for API calls, so no public
# domain needs to be entered here. CORS is only for external API clients.
FRONTEND_PORT_HOST=3000
BACKEND_PORT_HOST=8000
POSTGRES_PORT_HOST=5432
REDIS_PORT_HOST=6379
MINIO_PORT_HOST=9000
MINIO_CONSOLE_PORT_HOST=9001
ONLYOFFICE_PORT_HOST=8080

# --- General -----------------------------------------------------------------
# Site name, upload/import size limits, and session length all default
# sensibly in code and are the Admin > Site Settings page's job from here -
# only set one of these again if it genuinely needs to differ from what the
# UI can already do (a fallback for when the database itself is unreachable).
WIKIHUB_ENV=development                 # development | production | test
WIKIHUB_DEBUG=true
WIKIHUB_LOG_LEVEL=INFO
WIKIHUB_LOG_FORMAT=console              # console | json  (use json in production)

# --- Security ----------------------------------------------------------------
# Generate with:  python -c "import secrets; print(secrets.token_urlsafe(64))"
# Unlike the settings above, this one cannot default itself sensibly: left
# unset it self-generates a new random key on every process start, which
# would silently log everyone out on every restart (and disagree between the
# backend and worker processes, which each start separately) - and starting
# with WIKIHUB_ENV=production and this placeholder is refused outright.
WIKIHUB_SECRET_KEY=dev-only-insecure-secret-change-me-before-any-real-deployment
# Also the origin list MinIO accepts on presigned attachment URLs; left unset
# MinIO answers every browser preflight with Allow-Origin: *.
WIKIHUB_CORS_ORIGINS=http://localhost:3000

# --- Data storage -------------------------------------------------------------
# Where Postgres, Redis, MinIO, and automated backups actually keep their data
# on the host, instead of a Docker-managed named volume buried under
# /var/lib/docker. docker-compose.yml bind-mounts one subdirectory per store
# underneath this - postgres/, redis/, minio/, automated-backups/ - created
# automatically on first `docker compose up`. Point this at whatever
# partition a real server reserves for WikiHub's data; left at the default,
# it is just a folder next to the repo checkout.
WIKIHUB_DATA_HOST_DIRECTORY=./data

# Automated backups only, on their own disk/mount instead of living under
# WIKIHUB_DATA_HOST_DIRECTORY above - handy when backups need to land on a
# second drive or a network share rather than next to the live database.
# Leave unset to keep them under WIKIHUB_DATA_HOST_DIRECTORY/automated-backups.
# WIKIHUB_BACKUP_HOST_DIRECTORY=/mnt/backup-disk/wikihub

# --- PostgreSQL --------------------------------------------------------------
# The only place Postgres credentials are set. The official Postgres image
# reads these directly (at initdb time); the app assembles its own
# connection string from the same three values (app/core/config.py), so
# there is nothing else to keep in sync.
POSTGRES_USER=wikihub
POSTGRES_PASSWORD=wikihub_dev_password
POSTGRES_DB=wikihub

# --- Redis -------------------------------------------------------------------
WIKIHUB_REDIS_URL=redis://redis:6379/0

# --- Object storage (S3 compatible; MinIO locally) ---------------------------
WIKIHUB_S3_ENDPOINT_URL=http://minio:9000
# Not set here: WIKIHUB_S3_PUBLIC_ENDPOINT_URL (legacy direct-S3 compatibility).
# docker-compose.yml sets it from MINIO_PORT_HOST above, since it must track
# whichever host port MinIO actually published - a static line here would go
# stale the moment that port changes.
WIKIHUB_S3_REGION=us-east-1
WIKIHUB_S3_BUCKET=wikihub
WIKIHUB_S3_ACCESS_KEY_ID=wikihub_minio_admin
WIKIHUB_S3_SECRET_ACCESS_KEY=wikihub_minio_password
WIKIHUB_S3_USE_PATH_STYLE=true          # true for MinIO, false for real AWS S3

MINIO_ROOT_USER=wikihub_minio_admin
MINIO_ROOT_PASSWORD=wikihub_minio_password

# --- Page export (PDF/HTML/Word) ----------------------------------------------
# Page export renders the real page in a headless browser and captures it, so
# 1:1 fidelity is exact rather than a second, hand-maintained stylesheet. This
# is where the backend's browser reaches the frontend to do that; outside
# docker-compose, override it to wherever the frontend is reachable from the
# backend process.
WIKIHUB_FRONTEND_INTERNAL_URL=http://frontend:3000

# --- ONLYOFFICE attachment editing ------------------------------------------
# Use a long random value shared with the Document Server container. Generate
# one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
WIKIHUB_ONLYOFFICE_JWT_SECRET=replace-this-onlyoffice-jwt-secret-with-a-random-48-character-value
# The default compose values let OnlyOffice call WikiHub internally. Override
# both URLs only when services run on different hosts or behind a proxy.
WIKIHUB_ONLYOFFICE_ENABLED=true
WIKIHUB_ONLYOFFICE_BACKEND_URL=http://backend:8000
WIKIHUB_ONLYOFFICE_INTERNAL_URL=http://onlyoffice

# --- Bootstrap admin ---------------------------------------------------------
# Seeded automatically on the first `./scripts/run.sh`, and resynced to these
# four values on every run after that.
#
# This account is PROTECTED: it cannot be renamed, deactivated, deleted, or have
# its password changed through the API or the admin UI, so you always have a
# way back in. The one way to change any of the four values below - including
# rotating a compromised password - is editing them here and restarting; a
# value left unchanged is never rewritten, and a username/e-mail that would
# collide with a different account is safely skipped rather than applied.
#
# Change the password BEFORE the first run for anything network-reachable.
# Starting the app with WIKIHUB_ENV=production and the default password is
# refused outright.
WIKIHUB_ADMIN_USERNAME=admin
WIKIHUB_ADMIN_PASSWORD=admin123
WIKIHUB_ADMIN_EMAIL=admin@wikihub.local
WIKIHUB_ADMIN_FULL_NAME=WikiHub Administrator

# --- Frontend ----------------------------------------------------------------
# Legacy direct API base URL. Browser requests use the current origin and the
# Next.js same-origin proxy, so this does not need to match a public domain.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
# Server-side (inside the compose network) API base URL used by React Server Components.
API_INTERNAL_BASE_URL=http://backend:8000
NEXT_PUBLIC_ONLYOFFICE_DOCUMENT_SERVER_URL=http://localhost:8080
